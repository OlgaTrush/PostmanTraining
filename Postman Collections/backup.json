		{
			"name": "GET /pet/{petId}",
			"item": [
				{
					"name": "Get pet by id",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"id": "c37a49be-ebf8-4da0-8ecc-4ce8a653284f",
								"exec": [
									"const postPetRequest = {",
									"    url: pm.globals.get(\"BASE_URL\") + '/pet',",
									"    method: 'POST',",
									"    header: {",
									"        'Content-Type': 'application/json',",
									"    },",
									"    body: {",
									"        mode: 'raw',",
									"        raw: JSON.stringify({",
									"            \"id\": 0,",
									"            \"category\": {",
									"                \"id\": 0,",
									"                \"name\": \"string\"",
									"            },",
									"            \"name\": \"doggie\",",
									"            \"photoUrls\": [",
									"                \"string\"",
									"            ],",
									"            \"tags\": [",
									"                {",
									"                    \"id\": 0,",
									"                    \"name\": \"string\"",
									"                }",
									"            ],",
									"            \"status\": \"available\"",
									"        })",
									"    }",
									"};",
									"",
									"pm.sendRequest(postPetRequest, function (err, res) {",
									"    pm.test(\"POST /pet returns 200\", function () {",
									"        pm.expect(res).to.have.status(200);",
									"    });",
									"",
									"    let response = res.text().replace(/([^\"\\w-])([-0-9.]{8,100})([^\"\\w-])/g, '$1\"$2\"$3');",
									"    let jsonData = JSON.parse(response);",
									"    let id = jsonData.id.replace('\"','');",
									"",
									"    console.log(\"Pet id is \" + id);",
									"",
									"    pm.environment.set(\"dev_petid\", id);",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
