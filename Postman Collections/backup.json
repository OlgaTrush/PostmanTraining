						{
							"listen": "test",
							"script": {
								"id": "85136f03-db07-4c89-a0c1-e320f9db55ef",
								"exec": [
									"pm.test(\"Check a name\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.category.name).to.eql(pm.variables.get(\"name\"));",
									"});",
									"",
									"pm.test(\"Check pet name is cat\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.name).to.eql(\"cat\");",
									"});",
									"",
									"pm.test(\"Check status is pending\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql(\"pending\");",
									"});",
									"",
									"const GETpendingPets = {",
									"url: pm.globals.get(\"BASE_URL\") + \"/pet/findByStatus?status=pending\",",
									"method: 'GET',",
									"header: {",
									"'Content-Type': 'application/json',",
									"},",
									"};",
									"",
									"pm.sendRequest(GETpendingPets, function (err, res) {",
									"    pm.test(\"Get pet by status returns 200 and returns pets with pending status\", function () {",
									"        pm.expect(err).to.be.null;",
									"        pm.expect(res).to.have.status(200);",
									"",
									"        const jsonData = res.json();",
									"",
									"        pm.expect(jsonData.every(pet => pet.status === \"pending\")).to.be.true;",
									"    });",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
